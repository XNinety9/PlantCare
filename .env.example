# Docker image: token for the bundled Claude CLI, from `claude setup-token` (uses your Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=

# Required when the Claude CLI is not installed. Keep it empty in Docker: when set, the CLI uses this key
# instead of the subscription.
ANTHROPIC_API_KEY=

# Model used to identify plants, write care sheets and run health checks
PLANTCARE_MODEL=claude-haiku-5-5

# Optional: protect the app with a password (leave empty to disable)
PLANTCARE_PASSWORD=

# Optional: signing key for sessions, the calendar link and vacation pages.
# Generated in data/secret.key when empty; changing it invalidates all of them.
PLANTCARE_SECRET=

# Timezone used to compute "today" for care reminders
TZ=Europe/Paris

# Growing season: "north" (March to September) or "south"
PLANTCARE_HEMISPHERE=north

# Optional: daily care summary through ntfy (https://ntfy.sh or a self-hosted server)
PLANTCARE_NTFY_URL=
PLANTCARE_NTFY_TOKEN=
PLANTCARE_NOTIFY_TIME=08:30
PLANTCARE_NOTIFY_LANG=fr
# Opened when you tap the notification
PLANTCARE_PUBLIC_URL=
